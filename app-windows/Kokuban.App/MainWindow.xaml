<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kokuban.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Kokuban.App.Ui"
    Title="Kokuban">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" KeyDown="OnKey" PreviewKeyDown="OnPreviewKey">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sidebar: sections, projects and their sessions; the other PCs at its foot. -->
        <Grid x:Name="NavigationPane" Grid.Column="0" Background="{ThemeResource SideBrush}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="SideHeadRow" Height="80" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="6" Margin="12,40,12,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Agents" Style="{StaticResource PillButton}" Click="OpenAgents" Width="98" />
                    <Button Content="iPhones" Style="{StaticResource PillButton}" Click="OpenPhones" Width="98" />
                </StackPanel>
                <Button x:Name="UsageButton" Content="利用状況" Style="{StaticResource PillButton}" Click="OnUsage" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                <Button x:Name="SessionLaunchButton" Content="外部セッションを起動・再開" Style="{StaticResource PillButton}" Click="OnSessionLaunch" HorizontalAlignment="Stretch" Visibility="Collapsed" />
            </StackPanel>
            <ScrollViewer x:Name="SideScroll" Grid.Row="1" Padding="10,4,10,0" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Canvas x:Name="SideUnder" />
                    <StackPanel x:Name="Side" Spacing="1" Padding="0,0,0,12" />
                </Grid>
            </ScrollViewer>
            <StackPanel x:Name="Pcs" Grid.Row="2" Padding="10,16,10,12" Spacing="1" />
        </Grid>

        <!-- The list. -->
        <Grid x:Name="ListPane" Grid.Column="1" Background="{ThemeResource PaneBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0.5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="Head" Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="18,6,18,8" Visibility="Collapsed">
                <TextBlock x:Name="HeadTitle" FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource Ink}" />
                <TextBlock x:Name="HeadNote" FontSize="12" Foreground="{ThemeResource Ink2}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
            </StackPanel>
            <ScrollViewer x:Name="ColScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,8,0,12">
                    <TextBlock x:Name="Problem" Visibility="Collapsed" Margin="18,4,18,8" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource Ink2}" />
                    <Grid>
                        <Canvas x:Name="RowsUnder" />
                        <StackPanel x:Name="Rows" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The detail. -->
        <ScrollViewer x:Name="DetScroll" Grid.Column="2" Background="{ThemeResource PaneBrush}" VerticalScrollBarVisibility="Auto">
            <ui:DetailView x:Name="Detail" Margin="34,52,34,28" MaxWidth="720" HorizontalAlignment="Left" />
        </ScrollViewer>

        <ContentControl x:Name="AgentList" Grid.Column="1" Margin="0,38,0,0" Background="{ThemeResource PaneBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
        <ContentControl x:Name="AgentDetail" Grid.Column="2" Margin="0,38,0,0" Background="{ThemeResource PaneBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />

        <Grid x:Name="UsageHost" Grid.ColumnSpan="3" Margin="0,38,0,0" Background="{ThemeResource PaneBrush}" Visibility="Collapsed">
            <ui:UsageDashboardView x:Name="UsageView" />
        </Grid>
        <ContentControl x:Name="SessionLaunchHost" Grid.ColumnSpan="3" Margin="0,38,0,0" Background="{ThemeResource PaneBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />

        <!-- The title bar: drag anywhere along the top; Windows' own caption buttons on the right. -->
        <Grid x:Name="TitleBar" Grid.ColumnSpan="3" Height="38" VerticalAlignment="Top" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/icon-64.png" Width="16" Height="16" />
                <TextBlock x:Name="AppName" Text="Kokuban" FontSize="12" Foreground="{ThemeResource Ink2}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
